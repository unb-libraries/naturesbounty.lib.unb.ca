{
  "authors": [
    {
      "name": "UNB Libraries libsupport@unb.ca",
      "role": "Creator"
    }
  ],
  "autoload": {
    "classmap": [
      "scripts/composer/ScriptHandler.php"
    ]
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "cweagans/composer-patches": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "drupal/core-composer-scaffold": true,
      "php-http/discovery": true,
      "phpstan/extension-installer": true,
      "tbachert/spi": true
    },    
    "discard-changes": true,
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true
  },
  "conflict": {
    "drupal/drupal": "*"
  },
  "description": "Drupal 11 component of naturesbounty.lib.unb.ca",
  "extra": {
    "drupal-scaffold": {
      "locations": {
        "web-root": "./"
      }
    },
    "enable-patching": true,
    "installer-paths": {
      "core": [
        "type:drupal-core"
      ],
      "libraries/{$name}": [
        "type:drupal-library"
      ],
      "modules/contrib/{$name}": [
        "type:drupal-module"
      ],
      "profiles/contrib/{$name}": [
        "type:drupal-profile"
      ],
      "themes/contrib/{$name}": [
        "type:drupal-theme"
      ],
      "Commands/contrib/{$name}": [
        "type:drupal-drush"
      ],
      "modules/custom/{$name}": [
        "type:drupal-custom-module"
      ],
      "profiles/custom/{$name}": [
        "type:drupal-custom-profile"
      ],
      "themes/custom/{$name}": [
        "type:drupal-custom-theme"
      ]
    },
    "patches": {
      "drupal/bootstrap": {
        "3.x schema fixes": "https://www.drupal.org/files/issues/2023-04-27/bootsrtap-2883714-20.patch"
      },
      "drupal/simple_sitemap": {
        "4.x type error fix": "https://www.drupal.org/files/issues/2024-03-07/3426232-2-typeError.patch"
      }
    }
  },
  "license": "MIT",
  "minimum-stability": "dev",
  "name": "unb-libraries/naturesbounty.lib.unb.ca",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    },
    {
      "package": {
        "dist": {
          "type": "zip",
          "url": "https://github.com/TurbojetTechnologies/colorbox/archive/refs/tags/1.7.0.zip"
        },
        "name": "jackmoore/colorbox",
        "require": {
          "composer/installers": "^2"
        },
        "type": "drupal-library",
        "version": "1.7.0"
      },
      "type": "package"
    }
  ],
  "require": {
    "drupal/bootstrap": "^3.36",
    "drupal/color": "^2", 
    "drupal/colorbox": "^2",
    "drupal/core": "^11",
    "drupal/core-composer-scaffold": "^11",
    "drupal/core-recommended": "^11",
    "drupal/google_analytics": "^4",
    "drupal/health_check": "^3",
    "drupal/jquery_ui": "^1",
    "drupal/jquery_ui_draggable": "^2",
    "drupal/jquery_ui_resizable": "^2",
    "drupal/quickedit": "^1",
    "drupal/rdf": "^3", 
    "drupal/redis": "^1",
    "drupal/simple_sitemap": "^4",
    "jackmoore/colorbox": "^1",
    "unb-libraries/composer-drupal-scaffold": "^11"
  },
  "require-dev": {
    "unb-libraries/drupal-development-libraries": "^11"
  },
  "type": "project"
}
